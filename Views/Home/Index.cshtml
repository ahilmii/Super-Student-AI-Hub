@{
    ViewData["Title"] = "Super Student AI Hub";
    // YENİ EKLEME: Özet sonucunu öncelikle TempData'dan okur, yoksa ViewBag'e bakar.
    var summary = TempData["SummaryResult"] as string ?? ViewBag.SummaryResult as string;
}

<h1>Super Student AI Hub</h1>
<p>Ders Notu Özetleme Modülü (ChatGPT)</p>

<form asp-action="Summarize" method="post">
    <textarea name="inputText" rows="7" style="width:100%;" placeholder="Metni buraya yapıştır"></textarea>

    <br /><br />

    <select name="level" style="width:200px;">
        <option value="kısa">Kısa Özet</option>
        <option value="orta">Orta Özet</option>
        <option value="uzun">Uzun Özet</option>
    </select>

    <br /><br />
    <button type="submit" class="btn btn-primary">Özetle</button>
</form>

<hr />

@if (!string.IsNullOrEmpty(summary)) // ViewBag.SummaryResult yerine 'summary' değişkenini kullanıyoruz
{
    <h3>Özet Sonucu:</h3>
    <div style="white-space:pre-wrap; border:1px solid #ccc; padding:10px; border-radius:6px;">
        <div id="summaryText">@summary</div> 
    </div>

    <hr />
}

<form asp-action="SummarizeFile" method="post" enctype="multipart/form-data">
    <h3>PDF / Word Dosyası Yükle</h3>

    <input type="file" name="uploadedFile" accept=".pdf,.docx" />

    <br /><br />

    <select name="level" style="width:200px;">
        <option value="short">Short Summary</option>
        <option value="medium">Medium Summary</option>
        <option value="long">Long Summary</option>
    </select>

    <br /><br />
    <button type="submit" class="btn btn-primary">Özetle (Dosya)</button>
</form>

<form method="post" asp-controller="Home" asp-action="GenerateAudio">
    <textarea name="text" class="form-control" rows="4">@summary</textarea>
    <button type="submit" class="btn btn-primary mt-2">Seslendir</button>
</form>



