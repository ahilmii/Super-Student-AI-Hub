@{
    ViewData["Title"] = "AI Visual Generator";
}

<div class="container">
    <!-- Navbar (Home sayfasıyla aynı) -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/Logo.png" alt="SuperStudentAIHub Logo" class="navbar-logo" />
                SuperStudentAIHub
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">🏠 Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Visuals" asp-action="Index">🎨 AI Visuals</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="main-content">
        <h1>AI Visual Generator</h1>
        <p class="subtitle">Turn your notes into flowcharts or concept art with artificial intelligence.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger mt-2" role="alert">
                @ViewBag.Error
            </div>
        }

        <!-- Input Card -->
        <div class="card shadow-sm p-4 mb-4 ai-card">
            <form asp-action="Generate" method="post">
                <div class="form-group mb-3">
                    <label for="inputText" class="form-label"><strong>Describe your concept:</strong></label>
                    <textarea name="inputText"
                              id="inputText"
                              rows="4"
                              class="form-control"
                              placeholder="e.g., 'Timeline of the French Revolution' or 'A cyberpunk city in rain'">@ViewBag.InputText</textarea>
                </div>

                <div class="row g-3 align-items-center">
                    <div class="col-auto">
                        <select name="visualType" class="form-select" style="min-width: 260px;">
                            @if (ViewBag.SelectedVisualType == "schematic")
                            {
                                <option value="schematic" selected>
                                    Schematic (Diagram/Flowchart)
                                </option>
                            }
                            else
                            {
                                <option value="schematic">
                                    Schematic (Diagram/Flowchart)
                                </option>
                            }
                            @if (ViewBag.SelectedVisualType == "image")
                            {
                                <option value="image" selected>
                                    Visual Art (Illustration)
                                </option>
                            }
                            else
                            {
                                <option value="image">
                                    Visual Art (Illustration)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary px-4">🎨 Generate</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Results -->
        @if (ViewBag.ResultType == "schematic")
        {
            <div class="results card shadow p-4">
                <h3>📊 Schematic Result</h3>
                <p class="text-muted small mb-3">Generated using Mermaid.js</p>

                <div class="results-content mermaid text-center">
                    @Html.Raw(ViewBag.SchematicCode)
                </div>
            </div>

            <script type="module">
                import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
                mermaid.initialize({ startOnLoad: true, theme: 'default' });
            </script>
        }
        else if (ViewBag.ResultType == "image")
        {
            <div class="results card shadow p-4 text-center">
                <h3>🖼️ Visual Result</h3>
                <div class="mt-3">
                    <img src="@ViewBag.ImageUrl"
                         alt="AI Generated Visual"
                         class="img-fluid rounded shadow-lg" />
                </div>
                <div class="mt-2 text-muted">
                    <small>Generated via Pollinations.ai</small>
                </div>
            </div>
        }
    </div>
</div>
