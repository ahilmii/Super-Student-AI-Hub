@{
    ViewData["Title"] = "AI Visual Generator";
}

<div class="container mt-4">
    <h1 class="display-4">AI Visual Generator</h1>
    <p class="lead">Turn your notes into flowcharts or concept art.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.Error
        </div>
    }

    <div class="card shadow-sm p-4 mb-4">
        <form asp-action="Generate" method="post">
            <div class="form-group mb-3">
                <label for="inputText" class="form-label"><strong>Describe your concept:</strong></label>
                <textarea name="inputText" id="inputText" rows="4" class="form-control"
                    placeholder="e.g., 'Timeline of the French Revolution' or 'A cyberpunk city in rain'">@ViewBag.InputText</textarea>
            </div>

            <div class="row g-3 align-items-center">
                <div class="col-auto">
                    <select name="visualType" class="form-select" style="min-width: 250px;">
                        <!option value="schematic" @(ViewBag.SelectedVisualType == "schematic" ? "selected" : "")>
                            Schematic (Diagram/Flowchart)</!option>
                        <!option value="image" @(ViewBag.SelectedVisualType == "image" ? "selected" : "")>Visual Art
                            (Illustration)</!option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary px-4">Generate</button>
                </div>
            </div>
        </form>
    </div>

    @if (ViewBag.ResultType == "schematic")
    {
        <div class="card shadow p-4">
            <h3>Schematic Result:</h3>
            <p class="text-muted small">Generated using Mermaid.js</p>

            <div class="mermaid text-center">
                @Html.Raw(ViewBag.SchematicCode)
            </div>
        </div>

        <script type="module">
            import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
            mermaid.initialize({ startOnLoad: true, theme: 'default' });
        </script>
    }
    else if (ViewBag.ResultType == "image")
    {
        <div class="card shadow p-4 text-center">
            <h3>Visual Result:</h3>
            <div class="mt-3">
                <img src="@ViewBag.ImageUrl" alt="AI Generated Visual" class="img-fluid rounded shadow-lg" />
            </div>

            <div class="mt-3 p-2 bg-light border rounded text-break">
                @* <small>
                    <strong>Debug URL:</strong>
                    <a href="@ViewBag.ImageUrl" target="_blank">@ViewBag.ImageUrl</a>
                </small> *@
            </div>
            <div class="mt-2 text-muted">
                <small>Generated via Pollinations.ai</small>
            </div>
        </div>
    }
</div>